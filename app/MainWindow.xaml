<Window x:Class="XScribeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XScribeDesktop"
        xmlns:pw="clr-namespace:XScribeDesktop.PrWalker"
        Title="XScribe Desktop" Height="640" Width="420"
        Icon="/Assets/xscribe-icon.ico"
        Topmost="True"
        Background="#0F1523"
        WindowStartupLocation="Manual" Left="900" Top="60"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:SpeakerColorConverter x:Key="SpeakerColor"/>

        <Style x:Key="XsButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1A2540"/>
            <Setter Property="Foreground" Value="#C0CCE0"/>
            <Setter Property="BorderBrush" Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="XsToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#1A2540"/>
            <Setter Property="Foreground" Value="#4A6080"/>
            <Setter Property="BorderBrush" Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="Foreground" Value="#6080A0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#0F1523" BorderThickness="0" Margin="4">
        <TabItem Header="XScribe" Style="{StaticResource TabHeader}">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0C1428" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3A4A60" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready — click Start" Foreground="#6080A0" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="StartBtn" Content="▶ Start" Style="{StaticResource XsButton}" Click="StartBtn_Click"/>
                    <Button x:Name="StopBtn" Content="■ Stop" Style="{StaticResource XsButton}" Click="StopBtn_Click" IsEnabled="False"/>
                    <Button x:Name="SaveBtn" Content="↓ Save" Style="{StaticResource XsButton}" Click="SaveBtn_Click"/>
                    <Button x:Name="ClearBtn" Content="✕ Clear" Style="{StaticResource XsButton}" Click="ClearBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="MIC DEVICE" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshDevicesBtn" Content="↺" Style="{StaticResource XsButton}" Padding="6,2" Margin="0" HorizontalAlignment="Right" Click="RefreshDevicesBtn_Click"/>
                    </Grid>
                    <ComboBox x:Name="MicCombo" Margin="0,0,0,6" Background="#1A2540" Foreground="#C0CCE0" BorderBrush="#2A3A55" FontFamily="Consolas" FontSize="10"
                              DisplayMemberPath="Name" SelectedValuePath="Index"/>
                    <TextBlock Text="SYSTEM AUDIO (them)" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SpeakerCombo" Background="#1A2540" Foreground="#C0CCE0" BorderBrush="#2A3A55" FontFamily="Consolas" FontSize="10"
                              DisplayMemberPath="Name" SelectedValuePath="Index"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="CONTEXT" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="BriefModeBtn" Content="⚡ Brief + 3" Style="{StaticResource XsToggle}" IsChecked="True" Width="120" Click="ModeBtn_Click"/>
                    <ToggleButton x:Name="FullModeBtn" Content="📋 Full transcript" Style="{StaticResource XsToggle}" Width="120" Click="ModeBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="TARGET" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="💻 Claude Code Desktop" Foreground="#00FF88" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="SCOPE" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="RepoScopeBtn" Content="📁 Repo" Style="{StaticResource XsToggle}" IsChecked="True" Width="120" Click="ScopeBtn_Click"/>
                        <ToggleButton x:Name="GeneralScopeBtn" Content="🌐 General" Style="{StaticResource XsToggle}" Width="120" Click="ScopeBtn_Click"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="REPO CONTEXT (used when scope = Repo)" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BrowseRepoBtn" Content="📁 Browse" Style="{StaticResource XsButton}" Padding="6,2" Click="BrowseRepoBtn_Click"/>
                            <Button x:Name="DetectRepoBtn" Content="⟲ Detect" Style="{StaticResource XsButton}" Padding="6,2" Margin="0" Click="DetectRepoBtn_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="RepoContextBox" Height="36" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="#0C1428" Foreground="#C0CCE0" BorderBrush="#2A3A55" BorderThickness="1"
                             FontFamily="Consolas" FontSize="10" Padding="6"
                             TextChanged="RepoContextBox_TextChanged"
                             Text="d2c-admin-tools — E:\SL\d2c-admin-tools (Spotlight UI Okta/BFF auth work)"/>
                </StackPanel>

                <StackPanel Grid.Row="6" Margin="0,0,0,8">
                    <TextBlock Text="CALL BRIEF" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                    <TextBox x:Name="BriefBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="#0C1428" Foreground="#C0CCE0" BorderBrush="#2A3A55" BorderThickness="1"
                             FontFamily="Consolas" FontSize="10" Padding="6"
                             Text="e.g. Demoing Spotlight V2 BFF auth. Topics: Okta PKCE, cookie chunking, SSR session."/>
                    <Button x:Name="SetBriefBtn" Content="✓ Set Brief" Style="{StaticResource XsButton}" HorizontalAlignment="Right" Margin="0,4,0,0" Click="SetBriefBtn_Click"/>
                </StackPanel>

                <Grid Grid.Row="7" Margin="0,0,0,4">
                    <TextBlock Text="Live Transcript" Foreground="#4A6080" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CountText" Text="0 sentences" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                </Grid>

                <ListBox Grid.Row="8" x:Name="SentenceList" Background="#0F1523" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="SentenceItem_Click"/>
                            <EventSetter Event="MouseRightButtonUp" Handler="SentenceItem_Pin"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141E33" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="6" Padding="9" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sent}" Value="True">
                                                <Setter Property="BorderBrush" Value="#00FF88"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF6B9D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,4,8,0" VerticalAlignment="Top"
                                            Background="{Binding Speaker, Converter={StaticResource SpeakerColor}}"/>
                                    <TextBlock Text="{Binding Text}" Foreground="#DCE8F8" FontSize="13" TextWrapping="Wrap" Width="310"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="9" Background="#0C1428" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="Click → CCD · Right-click → Pin to PR Walker" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SendStatusText" Text="—" Foreground="#4A6080" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="PR Walker" Style="{StaticResource TabHeader}">
            <pw:PrWalkerView x:Name="PrWalker"/>
        </TabItem>
    </TabControl>
</Window>
