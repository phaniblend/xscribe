<Window x:Class="XScribeDesktop.PrWalker.TabPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose GitHub PR tab" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F1523" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" Text="Select the GitHub PR Files/Changes tab (any monitor)" Foreground="#6080A0"
                   FontFamily="Consolas" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <ListBox x:Name="TabList" Grid.Row="1" Background="#141E33" BorderBrush="#2A3A55"
                 DisplayMemberPath="Display" Foreground="#DCE8F8" FontFamily="Consolas" FontSize="11"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Padding="12,6" Margin="0,0,8,0" Click="Refresh_Click"
                    Background="#1A2540" Foreground="#C0CCE0" BorderBrush="#2A3A55"/>
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"
                    Background="#1A2540" Foreground="#C0CCE0" BorderBrush="#2A3A55"/>
            <Button Content="Bind tab" Padding="12,6" IsDefault="True" Click="Ok_Click"
                    Background="#1A2540" Foreground="#00E5FF" BorderBrush="#00E5FF"/>
        </StackPanel>
    </Grid>
</Window>
