{
  "manifest_version": 3,
  "name": "Tab Sync Helper",
  "version": "1.1.6",
  "description": "Synchronizes browser tabs with local development tools.",
  "permissions": ["tabs", "scripting", "alarms", "storage", "offscreen"],
  "host_permissions": [
    "https://github.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Sync Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
